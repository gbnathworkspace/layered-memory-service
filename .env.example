# "local" reads from this file. "production" pulls secrets from AWS SSM.
APP_ENV=local

# --- Local dev only (ignored in production) ---
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=layered_memory
VOYAGE_API_KEY=pa-...
MEMORY_SERVICE_API_KEY=your-internal-shared-secret

# --- Production env vars (set in Railway, not here) ---
# APP_ENV=production
# AWS_REGION=ap-south-1
# DB_SSM_PARAM_NAME=/mentorman/mongodb-uri   ← SSM path that holds the MongoDB URI
# MONGODB_DB_NAME=layered_memory             ← non-secret, set directly
# LOG_LEVEL=INFO

# Optional
LOG_LEVEL=INFO
